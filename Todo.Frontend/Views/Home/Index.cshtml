@model IEnumerable<Todo.Frontend.Models.TodoItem>
@{
    ViewData["Title"] = "Todo List (Cloud Practice)";
    bool isConnected = ViewBag.IsBackendConnected == true;
    string backendUrl = ViewBag.BackendUrl ?? "";
    string errorMessage = ViewBag.ErrorMessage ?? "";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <!-- Cloud Connection Status Banner -->
            @if (isConnected)
            {
                <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                    <span class="me-2">✔</span>
                    <div>
                        <strong>Connected to Backend API:</strong> <code>@backendUrl/api/todos</code>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-4" role="alert">
                    <h5 class="alert-heading mb-1">Backend API Disconnected</h5>
                    <p class="mb-1">Could not connect to backend at <code>@backendUrl/api/todos</code>.</p>
                    <small class="text-muted">Error: @errorMessage</small>
                    <hr />
                    <small>For cloud deployment, configure the <code>BackendUrl</code> environment variable on the frontend container.</small>
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Todo Items (from Backend API)</h4>
                    <span class="badge bg-light text-primary">@Model.Count() Items</span>
                </div>
                <div class="card-body p-0">
                    @if (Model.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var item in Model)
                            {
                                <li class="list-group-item d-flex align-items-center justify-content-between py-3">
                                    <div class="d-flex align-items-center">
                                        <input class="form-check-input me-3" type="checkbox" @(item.IsCompleted ? "checked" : "") disabled />
                                        <span class="@(item.IsCompleted ? "text-decoration-line-through text-muted" : "fw-medium")">
                                            @item.Title
                                        </span>
                                    </div>
                                    <span class="badge @(item.IsCompleted ? "bg-success" : "bg-warning text-dark")">
                                        @(item.IsCompleted ? "Completed" : "Pending")
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <em>No todo items loaded. Make sure the backend API is running.</em>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
